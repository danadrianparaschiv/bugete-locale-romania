# environments & caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
.ruff_cache/

# secrets — never commit; see .env.example
.env

# per-page work artifacts (large, regenerable; runs/*/llm_cache holds the
# replayable LLM responses — regenerable at cost, kept local)
runs/

# working outputs in the repo root (committed workbooks live in data/)
/*.xlsx
/corpus.csv
/corpus.parquet
/corpus.json
/artifact-audit.json
/eval-report.json
/bundle-migration.json
/:memory:.ses

# OS noise
.DS_Store

# oversize corpus files (>100MB exceeds GitHub's hard limit) — fetched by
# data/<year>/download.py; manifest marks them oversize
data/2026/34-sibiu/143450-sibiu/budget_file.pdf

# The 2024 corpus keeps every raw PDF outside Git history.  Official source
# URLs, checksums and sizes are committed; normalized workbooks and analytics
# remain versioned.  Native municipal Excel sources are intentionally kept.
data/2024/**/budget_file.pdf
site/
evals/
