# Cheia Claude API pentru straturile opționale de reparare/transcriere LLM.
# Fără ea, rulați cu --llm off (implicit): extragerea și validarea
# funcționează complet offline; celulele nerezolvate rămân marcate în Excel.
ANTHROPIC_API_KEY=sk-ant-...

# Chei opționale pentru preseturile altor furnizori (`bgconvertor models`);
# necesită și pachetul openai: `uv sync --extra vendors`.
#OPENAI_API_KEY=sk-...
#GEMINI_API_KEY=...
#MISTRAL_API_KEY=...
#OPENROUTER_API_KEY=sk-or-v1-...
