# Cheia Claude API pentru straturile opționale de reparare/transcriere LLM.
# Fără ea, rulați cu --llm off (implicit): extragerea și validarea
# funcționează complet offline; celulele nerezolvate rămân marcate în Excel.
ANTHROPIC_API_KEY=sk-ant-...

# Chei opționale pentru preseturile altor furnizori (`bgconvertor models`);
# necesită și pachetul openai: `uv sync --extra vendors`.
#OPENAI_API_KEY=sk-...
#GEMINI_API_KEY=...
#MISTRAL_API_KEY=...
#OPENROUTER_API_KEY=sk-or-v1-...

# Opțiuni deterministe OCR/structură (valorile implicite sunt afișate).
# Motor: auto | rapidocr | easyocr | tesseract | tesseract_cli
#BGC_OCR_ENGINE=rapidocr
#BGC_OCR_LANGS=["ro","en"]
# Mod TableFormer: fast | accurate
#BGC_TABLEFORMER_MODE=accurate
#BGC_DOCLING_CELL_MATCHING=true
# A doua citire rulează numai sub scorul structural și păstrează candidatul
# nou numai dacă îl îmbunătățește. Nu folosește API-uri externe.
#BGC_ADAPTIVE_OCR=true
#BGC_STRUCTURAL_SCORE_THRESHOLD=0.85
#BGC_MAX_DESKEW_DEGREES=2.0
